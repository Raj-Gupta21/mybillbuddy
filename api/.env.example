# Set these in the shell or deployment secret manager before starting Spring.
# Rotate any database credential that was previously stored in source.
DB_URL=jdbc:mysql://localhost:3306/mybillbuddy?useSSL=false&serverTimezone=UTC
DB_USERNAME=your_database_user
DB_PASSWORD=
APP_LOGIN_USERNAME=your_operator_username
APP_LOGIN_PASSWORD=
# Generate a random secret with at least 32 bytes; keep it private.
JWT_SECRET=
JWT_ISSUER=mybillbuddy-api
# Access-token lifetime: 1 hour (minimum 60000, maximum 86400000 milliseconds).
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGIN=http://localhost:5173
